# Copyright (C) 2020 - Dreemurrs Embedded Labs
#
# These services are disabled due to them being unnecessary critical process
# and crash loop.

service lmkd lmkd_HYBRIS_DISABLED
    disabled
    oneshot
    override

service vendor.audio-hal-2-0 android.hardware.audio@2.0-service_HYBRIS_DISABLED
    disabled
    oneshot
    override

service vendor.audio-hal android.hardware.audio.service_DISABLED
    disabled
    oneshot
    override

service vendor.usb-hal-1-1 android.hardware.usb@1.1-service_HYBRIS_DISABLED
    disabled
    oneshot
    override

service vendor.usb-hal-1-2 android.hardware.usb@1.2-service_HYBRIS_DISABLED
    disabled
    oneshot
    override

# Disable console as it conflicts with the rootfs console
service console /system/bin/sh_HYBRIS_DISABLED
    disabled
    override

# Disable android framework side daemons lacking consumers in Halium
service statsd /apex/com.android.os.statsd/bin/statsd_HYBRIS_DISABLED
    disabled
    oneshot
    override

service incidentd /system/bin/incidentd_HYBRIS_DISABLED
    disabled
    oneshot
    override

service storaged /system/bin/storaged_HYBRIS_DISABLED
    disabled
    oneshot
    override

service idmap2d /system/bin/idmap2d_HYBRIS_DISABLED
    disabled
    oneshot
    override

service installd /system/bin/installd_HYBRIS_DISABLED
    disabled
    oneshot
    override

service credstore /system/bin/credstore_HYBRIS_DISABLED
    disabled
    oneshot
    override
